<%- include('../partials/head', { title: 'My profile' }) %><%- include('../partials/nav', { active: 'profile' }) %><main class="workspace narrow"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">YOUR PROFESSIONAL SIGNAL</span><h1>My profile</h1><p class="page-lead">Help companies understand the work behind your potential.</p></div></header><form class="content-card profile-form" action="/student/profile" method="post"><div class="form-grid"><label>Education<input name="education" value="<%= user.profile?.education || '' %>" placeholder="B.Tech Computer Science"></label><label>College / university<input name="college" value="<%= user.profile?.college || '' %>" placeholder="Your institution"></label><label>CGPA<input type="number" name="cgpa" min="0" max="10" step="0.01" value="<%= user.profile?.cgpa || '' %>" placeholder="8.5"></label><label>Skills <small>comma separated</small><input name="skills" value="<%= (user.profile?.skills || []).map(skill => skill.name).join(', ') %>" placeholder="React.js, Node.js, SQL"></label></div><label>About your work<textarea name="bio" rows="6" placeholder="Tell companies what you build and what you want to learn."><%= user.profile?.bio || '' %></textarea></label><button class="primary-btn inline-btn" type="submit">Save profile <span>↗</span></button></form></main><%- include('../partials/foot') %>
