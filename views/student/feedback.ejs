<%- include('../partials/head', { title: 'Feedback' }) %><%- include('../partials/nav', { active: 'feedback' }) %><main class="workspace narrow"><header class="workspace-heading"><div><span class="eyebrow">LEARN FROM EVERY OUTCOME</span><h1>Application feedback</h1><p class="page-lead">Clear signals from companies help you focus your next improvement.</p></div></header><section class="content-card feedback-list"><% if (!feedback.length) { %><p class="empty-state">Feedback will appear here as companies review your applications.</p><% } %><% feedback.forEach(item => { %><article class="feedback-item"><div><span class="application-status <%= item.decision === 'selected' ? 'progress' : 'declined' %>"><%= item.decision %></span><h2><%= item.application?.job?.title || 'Application' %></h2><small><%= item.company?.name || 'Company' %> · <%= new Date(item.createdAt).toLocaleDateString() %></small></div><div><strong><%= item.reason %></strong><p><%= item.feedback || 'No additional notes were shared.' %></p></div></article><% }) %></section></main><%- include('../partials/foot') %>
