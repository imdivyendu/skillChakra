<%- include('../partials/head', { title: 'Opportunities' }) %><%- include('../partials/nav', { active: 'opportunities' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">DISCOVER YOUR NEXT MOVE</span><h1>Opportunities</h1><p class="page-lead">Roles ranked by the skills you bring to the table.</p></div></header><div class="opportunity-list"><% if (!jobs.length) { %><section class="content-card empty-state">Companies have not posted opportunities yet.</section><% } %><% jobs.forEach(job => { %><article class="content-card opportunity-card"><div><span class="eyebrow"><%= job.employmentType %> · <%= job.location || 'Flexible' %></span><h2><%= job.title %></h2><p><strong><%= job.company?.name || 'Company' %></strong> · <%= job.description %></p><div class="tag-list"><% job.requiredSkills.forEach(skill => { %><span><%= skill %></span><% }) %></div></div><% if (applied.has(String(job.id))) { %><span class="application-status progress">Applied</span><% } else { %><form method="post" action="/student/opportunities/<%= job.id %>/apply"><button class="primary-btn inline-btn" type="submit">Apply now <span>↗</span></button></form><% } %></article><% }) %></div></main><%- include('../partials/foot') %>
