<%- include('../partials/head', { title: 'Student overview' }) %><%- include('../partials/nav', { active: 'dashboard' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">STUDENT WORKSPACE</span><h1>Good morning, <%= user.name.split(' ')[0] %>.</h1><p class="page-lead">Your next opportunity is closer than you think.</p></div><a class="outline-btn inline-btn" href="/student/profile">Complete profile ↗</a></header><div class="stats-row"><div class="stat-card"><span>PROFILE STRENGTH</span><strong><%= user.profile?.skills?.length ? '72%' : '35%' %></strong><small>Based on your details</small></div><div class="stat-card"><span>OPEN ROLES</span><strong><%= jobs.length %></strong><small>Matched opportunities</small></div><div class="stat-card"><span>APPLICATIONS</span><strong><%= applications.length %></strong><small>In your pipeline</small></div><div class="stat-card warm"><span>TRUST SCORE</span><strong><%= user.profile?.collegeScore || 0 %><small>/ 100</small></strong><small>College validation</small></div></div><div class="dashboard-grid"><section class="content-card"><div class="card-heading"><div><span class="eyebrow">YOUR SIGNAL</span><h2>Skill intelligence</h2></div><a class="text-btn" href="/student/profile">Edit profile ↗</a></div><div class="profile-snapshot"><div class="donut"><div><strong><%= user.profile?.skills?.length || 0 %></strong><small>skills</small></div></div><div><p class="muted-copy"><%= user.profile?.bio || 'Add your education, projects, and skills so companies can understand your potential.' %></p><div class="tag-list"><% (user.profile?.skills || []).forEach(skill => { %><span><%= skill.name %></span><% }) %></div></div></div></section><section class="content-card"><div class="card-heading"><div><span class="eyebrow">IN MOTION</span><h2>Recent applications</h2></div><a class="text-btn" href="/student/feedback">Feedback</a></div><% if (!applications.length) { %><p class="empty-state">No applications yet. Explore roles matched to your skills.</p><a class="full-link" href="/student/opportunities">Browse opportunities <span>↗</span></a><% } else { applications.forEach(application => { %><div class="application"><div><strong><%= application.job.title %></strong><small><%= application.job.location || 'Remote' %></small></div><span class="application-status progress"><%= application.status %></span></div><% }) } %></section></div></main><%- include('../partials/foot') %>
