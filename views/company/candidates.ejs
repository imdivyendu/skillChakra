<%- include('../partials/head', { title: 'Candidates' }) %><%- include('../partials/nav', { active: 'candidates' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">EVIDENCE OVER GUESSWORK</span><h1>Candidate review</h1><p class="page-lead">Compare verified skills and leave feedback that helps people grow.</p></div></header><div class="candidate-list"><% if (!applications.length) { %><section class="content-card empty-state">Applications will appear here when students apply to your roles.</section><% } %><% applications.forEach(application => { %><article class="content-card candidate-card"><div class="candidate-header"><div class="avatar large"><%= application.student.name.slice(0, 2).toUpperCase() %></div><div><h2><%= application.student.name %></h2><p><%= application.job.title %> · <%= application.student.profile?.college || 'College not added' %></p></div><strong class="match-number"><%= application.matchScore %><small> match</small></strong></div><div class="tag-list"><% (application.student.profile?.skills || []).forEach(skill => { %><span><%= skill.name %></span><% }) %></div><form class="decision-form" action="/company/applications/<%= application.id %>/decision" method="post"><select name="decision"><option value="selected">Select candidate</option><option value="rejected">Reject candidate</option></select><input name="reason" required placeholder="Decision reason, e.g. Strong React experience"><input name="feedback" placeholder="Specific feedback for the candidate"><button class="primary-btn inline-btn" type="submit">Send decision <span>↗</span></button></form></article><% }) %></div></main><%- include('../partials/foot') %>
