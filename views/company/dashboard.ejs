<%- include('../partials/head', { title: 'Company overview' }) %><%- include('../partials/nav', { active: 'dashboard' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">COMPANY WORKSPACE</span><h1>Build your next team.</h1><p class="page-lead">Turn skill signals into confident hiring decisions.</p></div><a class="primary-btn inline-btn" href="/company/jobs/new">Post opportunity <span>↗</span></a></header><div class="stats-row"><div class="stat-card"><span>OPEN OPPORTUNITIES</span><strong><%= jobs.filter(job => job.status === 'open').length %></strong><small>Currently recruiting</small></div><div class="stat-card"><span>CANDIDATES</span><strong><%= applications.length %></strong><small>Recent applications</small></div><div class="stat-card"><span>VERIFIED SIGNALS</span><strong>82%</strong><small>Average candidate trust</small></div><div class="stat-card warm"><span>TIME TO SHORTLIST</span><strong>3.2<small> days</small></strong><small>Team average</small></div></div><section class="content-card table-card"><div class="card-heading"><div><span class="eyebrow">YOUR PIPELINE</span><h2>Open opportunities</h2></div><a class="text-btn" href="/company/candidates">Review candidates ↗</a></div><% if (!jobs.length) { %><p class="empty-state">Post your first opportunity to start meeting verified talent.</p><% } else { jobs.forEach(job => { %><div class="table-row"><div><strong><%= job.title %></strong><small><%= job.requiredSkills.join(' · ') %></small></div><span class="application-status progress"><%= job.status %></span><a class="text-btn" href="/company/candidates">View talent</a></div><% }) } %></section></main><%- include('../partials/foot') %>
