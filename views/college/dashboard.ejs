<%- include('../partials/head', { title: 'College overview' }) %><%- include('../partials/nav', { active: 'dashboard' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">COLLEGE WORKSPACE</span><h1>Grow trusted talent.</h1><p class="page-lead">Help your students turn learning into a signal companies can trust.</p></div><a class="outline-btn inline-btn" href="/college/students">Manage students ↗</a></header><div class="stats-row"><div class="stat-card"><span>YOUR STUDENTS</span><strong><%= students.length %></strong><small>Profiles connected</small></div><div class="stat-card"><span>VERIFIED THIS TERM</span><strong><%= students.filter(student => student.profile?.collegeScore).length %></strong><small>Trust scores added</small></div><div class="stat-card"><span>AVERAGE TRUST</span><strong><%= students.length ? Math.round(students.reduce((sum, student) => sum + (student.profile?.collegeScore || 0), 0) / students.length) : 0 %><small>/ 100</small></strong><small>Student confidence signal</small></div><div class="stat-card warm"><span>DISCOVERY READY</span><strong><%= students.filter(student => student.profile?.skills?.length).length %></strong><small>Profiles with skills</small></div></div><section class="content-card table-card"><div class="card-heading"><div><span class="eyebrow">STUDENT SIGNALS</span><h2>Recent student profiles</h2></div><a class="text-btn" href="/college/students">See all ↗</a></div><% students.slice(0, 5).forEach(student => { %><div class="table-row"><div><strong><%= student.name %></strong><small><%= student.profile?.skills?.map(skill => skill.name).join(' · ') || 'Skills not added yet' %></small></div><span class="application-status progress"><%= student.profile?.collegeScore || 0 %>/100</span></div><% }) %><% if (!students.length) { %><p class="empty-state">Students who select your institution during signup will appear here.</p><% } %></section></main><%- include('../partials/foot') %>
