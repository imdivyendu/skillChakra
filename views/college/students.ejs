<%- include('../partials/head', { title: 'Student verification' }) %><%- include('../partials/nav', { active: 'students' }) %><main class="workspace"><%- include('../partials/flash', { notice }) %><header class="workspace-heading"><div><span class="eyebrow">VALIDATE THE WORK</span><h1>Student verification</h1><p class="page-lead">Give students a credible signal based on the learning you have seen.</p></div></header><section class="content-card table-card"><% if (!students.length) { %><p class="empty-state">No students are linked to this college yet.</p><% } %><% students.forEach(student => { %><div class="student-review"><div><strong><%= student.name %></strong><small><%= student.profile?.education || 'Education not added' %> · <%= student.profile?.skills?.map(skill => skill.name).join(', ') || 'No skills listed' %></small></div><form class="score-form" method="post" action="/college/students/<%= student.id %>/verify"><label>Trust score<input type="number" name="score" min="0" max="100" value="<%= student.profile?.collegeScore || 0 %>"></label><button class="outline-btn" type="submit">Save score</button></form></div><% }) %></section></main><%- include('../partials/foot') %>
